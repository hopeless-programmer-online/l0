f(x) {
    is : type(x)
    super(is)
    ; throw()
}

buffer : Array(3)
    x : ImmediateValue(f) ; current
    set(buffer, 0, x)
    x : DummyValue() ; super
    set(buffer, 1, x)
    x : ImmediateValue(1)
    set(buffer, 2, x) ; param

buffer : emulate_step(buffer)
; print(buffer)
buffer : emulate_step(buffer)
; print(buffer)
buffer : emulate_step(buffer)
; print(buffer)
buffer : emulate_step(buffer)
